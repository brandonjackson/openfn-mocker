    }
  ],
  "routes": {
    "DELETE /ws/rest/v1/*": "conforming",
    "GET /ws/fhir2/R4/Condition": "conforming",
    "GET /ws/fhir2/R4/Condition/:id": "conforming",
    "GET /ws/fhir2/R4/Encounter": "conforming",
    "GET /ws/fhir2/R4/Encounter/:id": "conforming",
    "GET /ws/fhir2/R4/Observation": "conforming",
    "GET /ws/fhir2/R4/Observation/:id": "conforming",
    "GET /ws/fhir2/R4/Patient": "conforming",
    "GET /ws/fhir2/R4/Patient/:id": "conforming",
    "GET /ws/rest/v1/*": "conforming",
    "GET /ws/rest/v1/session": "unchecked",
    "POST /ws/fhir2/R4/Condition": "conforming",
    "POST /ws/fhir2/R4/Encounter": "conforming",
    "POST /ws/fhir2/R4/Observation": "conforming",
    "POST /ws/fhir2/R4/Patient": "conforming",
